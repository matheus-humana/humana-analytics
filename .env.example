# =============================================================================
# ATTENTION — CREDENTIALS TIED TO A PERSONAL ACCOUNT (handover, 30/09/2026)
# =============================================================================
# The values currently set in Vercel and in `.env.local` for the variables
# below were created in the previous developer's PERSONAL accounts (mostly a
# personal Google Cloud project), not in company accounts. They work today, but
# they will stop working when that access is removed. Recreate each one in a
# company account, replace it in Vercel (and `.env.local`), redeploy, and only
# then ask for the old one to be revoked. Lines marked [PERSONAL] below.
#
#   Personal Google Cloud project:
#     GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,  → Google login breaks (nobody signs in)
#     AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET
#     GOOGLE_SERVICE_ACCOUNT_JSON / _KEY_PATH  → GA4 stops updating
#     PAGESPEED_API_KEY                        → PageSpeed falls back to the low anonymous quota
#     GEMINI_API_KEY (personal Google account) → chat falls back to Groq, or stops
#   Other personal accounts:
#     GROQ_API_KEY                             → chat fallback stops
#     GITHUB_TOKEN (personal GitHub token)     → hourly GitHub collect fails
#   Owner not confirmed, check before relying on them:
#     OPENAI_API_KEY, ANALYTICS_BOT_*          → not used while CHAT_ENGINE=native
#
#   Company-owned or generated, keep as they are:
#     DATABASE_URL, GA4_PROPERTY_ID, GITHUB_REPO, SITE_URL, CRON_SECRET,
#     AUTH_SECRET, CREDENTIALS_ENCRYPTION_KEY, APP_URL, AUTH_URL
#
# When recreating the Google OAuth client, add these authorized redirect URIs:
#   https://humana-analytics.vercel.app/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
#   plus GOOGLE_REDIRECT_URI below.
# The new service account email must be added in GA4 → Admin → Property access
# management as Viewer, with the "Google Analytics Data API" enabled.
# =============================================================================

# PostgreSQL connection string for humana-analytics.
# Use the production/shared Humana database with the isolated `analytics` schema.
# Configure the real value only in `.env.local` (never commit secrets).
DATABASE_URL=

# Google OAuth (Analytics readonly) — optional if using service account
# [PERSONAL] Google Cloud OAuth client. Also used for login (see AUTH_GOOGLE_* below).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Preferred for local/dev: service account JSON (never commit the file)
# [PERSONAL] Service account from a personal Google Cloud project. GA4 depends on it.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/ga4-service-account.json
# Or paste the full JSON in one line (avoid in shared shells/logs):
# GOOGLE_SERVICE_ACCOUNT_JSON=

# GA4 property numeric id (without "properties/" prefix)
GA4_PROPERTY_ID=

# Login: comma-separated email domains. Unset uses humana.ai,humana-ai.com.
# An explicit list replaces that default. Invalid tokens are ignored; if none
# remain, nobody can sign in.
# AUTH_ALLOWED_DOMAINS=humana.ai,humana-ai.com

# 32-byte key as 64 hex chars, or any secret string (hashed to 32 bytes)
CREDENTIALS_ENCRYPTION_KEY=

# App base URL used in OAuth redirects
APP_URL=http://localhost:3000

# Auth.js user login (Google). Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.
# Add this authorized redirect URI on the same OAuth client (in addition to GOOGLE_REDIRECT_URI):
#   http://localhost:3000/api/auth/callback/google
# AUTH_SECRET signs the session cookie. If empty, CREDENTIALS_ENCRYPTION_KEY is used.
# AUTH_ALLOWED_DOMAINS limits Google sign-in. See the comment above.
# [PERSONAL] Optional dedicated login client; wins over GOOGLE_CLIENT_* when set.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Chat engine. native uses an in-app model. bridge uses the Analytics Bot webhook.
# Unset keeps the previous order: webhook when ANALYTICS_BOT_WEBHOOK_URL is set,
# otherwise the first configured native provider.
CHAT_ENGINE=native
# gemini, groq, or openai. Defaults: primary gemini, fallback the next configured provider.
AI_PROVIDER_PRIMARY=gemini
AI_PROVIDER_FALLBACK=groq
# Free tier key from Google AI Studio: https://aistudio.google.com/apikey
# [PERSONAL] Created in a personal Google account. The company account needs an
# admin to allow Google Cloud project creation (it failed with 403).
GEMINI_API_KEY=
# Stable Flash-Lite id from the Gemini API docs (https://ai.google.dev/gemini-api/docs/models/gemini-3.5-flash-lite).
GEMINI_MODEL=gemini-3.5-flash-lite
# Free tier key from Groq: https://console.groq.com/keys
# [PERSONAL] Created in a personal Groq account.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Questions per signed-in user per hour. 0 disables the limit. Unset uses 30.
CHAT_RATE_LIMIT_PER_HOUR=30

# OpenAI remains a selectable native provider (AI_PROVIDER_PRIMARY=openai).
OPENAI_API_KEY=
# Cheap default for tests; override if needed (e.g. gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# GitHub repository traffic for the open-source launch.
# One repo, or several separated by commas. Do not commit a token.
# Example shape only: GITHUB_REPO=owner/name
# [PERSONAL] Personal GitHub token. Replace with a fine-grained token owned by the
# organization that holds GITHUB_REPO (read: Administration for traffic, Metadata).
GITHUB_TOKEN=
GITHUB_REPO=
# Vercel Cron calls GET /api/github/collect with Authorization: Bearer $CRON_SECRET.
# GITHUB_CRON_SECRET is an optional alias for a manual curl. Prefer CRON_SECRET on Vercel.
CRON_SECRET=
# GITHUB_CRON_SECRET=

# Site measured by PageSpeed and the SEO/GEO crawl. Required. No default URL is assumed.
SITE_URL=
# Optional extra pages for PageSpeed, comma-separated paths on SITE_URL.
# SEO_PAGES=/en,/pt
# SEO_MAX_PAGES=30
# SEO_CONCURRENCY=4
# SEO_LINK_CHECKS=40
# Cap on PageSpeed calls per chain (each page uses mobile and desktop).
# SEO_PAGESPEED_MAX=16
# Optional. Without it the API uses the anonymous low quota.
# [PERSONAL] Key from a personal Google Cloud project.
# PAGESPEED_API_KEY=
# Optional. Replaces the default AI referrer host list.
# AI_TRAFFIC_SOURCES=chatgpt.com,perplexity.ai,claude.ai

# Analytics Bot bridge. When ANALYTICS_BOT_WEBHOOK_URL is set, chat uses it
# instead of OpenAI. Humana Analytics POSTs each question and waits for
# POST /api/analytics-bot/reply. Set APP_URL to the public origin so replyUrl is reachable.
ANALYTICS_BOT_WEBHOOK_URL=
# Optional. Sent as Authorization: Bearer and X-Analytics-Bot-Key. Never log this value.
ANALYTICS_BOT_WEBHOOK_SECRET=
# Required to accept the bot callback. Send as Authorization: Bearer or X-Analytics-Bot-Reply-Secret.
ANALYTICS_BOT_REPLY_SECRET=
