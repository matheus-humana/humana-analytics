# PostgreSQL connection string for humana-analytics.
# Use the production/shared Humana database with the isolated `analytics` schema,
# or a local database (see docker-compose.yml).
# Configure the real value only in `.env.local` (never commit secrets).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/humana_analytics

# Optional names used to bootstrap the local project/data source on first sync.
ORGANIZATION_NAME=Humana AI
PROJECT_NAME=Humana Website

# GA4 property ID (numeric). Found in GA4 Admin → Property details.
# You may paste either `123456789` or `properties/123456789`.
GA4_PROPERTY_ID=123456789

# --- GA4 credentials (choose ONE of the three options) ---
#
# 1) Path to a service-account JSON key file (recommended locally)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/ga4-service-account.json
#
# 2) The full service-account JSON as a single-line string
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
#
# 3) Split email + private key (escape newlines as \n)
# GA4_CLIENT_EMAIL=ga4-reader@your-gcp-project.iam.gserviceaccount.com
# GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CLOUD_PROJECT=your-gcp-project

# Optional: require this value in `x-sync-secret` (or Bearer token) for POST /api/sync/ga4
# SYNC_SECRET=change-me

# Optional: allow the HTTP sync endpoint to load fixtures instead of calling GA4
# ALLOW_GA4_FIXTURE=true
