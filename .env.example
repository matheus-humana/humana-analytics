# PostgreSQL connection string for humana-analytics.
# Use the production/shared Humana database with the isolated `analytics` schema.
# Configure the real value only in `.env.local` (never commit secrets).
DATABASE_URL=

# Google OAuth (Analytics readonly) — optional if using service account
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Preferred for local/dev: service account JSON (never commit the file)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/ga4-service-account.json
# Or paste the full JSON in one line (avoid in shared shells/logs):
# GOOGLE_SERVICE_ACCOUNT_JSON=

# GA4 property numeric id (without "properties/" prefix)
GA4_PROPERTY_ID=

# Microsoft Clarity (Data Export API)
# Settings → Data Export → Generate new API token
CLARITY_PROJECT_ID=
CLARITY_API_TOKEN=

# Vercel Web Analytics (projeto do SITE, não deste app)
# Use WEB_ANALYTICS_* — na Vercel, VERCEL_PROJECT_ID é reservado e aponta para este app.
# Token: Vercel → Account Settings → Tokens
# Project ID: humana-website → Settings → General
WEB_ANALYTICS_TOKEN=
WEB_ANALYTICS_PROJECT_ID=
# Obrigatório se o projeto for de um team
# WEB_ANALYTICS_TEAM_ID=
# Legado (só local; em produção na Vercel não use VERCEL_PROJECT_ID)
# VERCEL_ACCESS_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# 32-byte key as 64 hex chars, or any secret string (hashed to 32 bytes)
CREDENTIALS_ENCRYPTION_KEY=

# App base URL used in OAuth redirects
APP_URL=http://localhost:3000

# Auth.js user login (Google). Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.
# Add this authorized redirect URI on the same OAuth client (in addition to GOOGLE_REDIRECT_URI):
#   http://localhost:3000/api/auth/callback/google
# AUTH_SECRET signs the session cookie. If empty, CREDENTIALS_ENCRYPTION_KEY is used.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# OpenAI (Humana Analytics agent)
OPENAI_API_KEY=
# Cheap default for tests; override if needed (e.g. gpt-4o)
OPENAI_MODEL=gpt-4o-mini
